# Protocol Soft — platform root environment (TEMPLATE — no real secrets)
#
# RULES (Phase 1/2 approved):
# - Real secrets live ONLY on the server (env / secrets store), never in Git.
# - The web service NEVER holds PostgreSQL credentials.
# - Each internal key has ONE purpose; keys are not interchangeable.
# - .env.example files document names only. Copy to .env on the server and fill values there.

# ── Environment ─────────────────────────────────────────────
NODE_ENV=development                # development | production
DEPLOYMENT_ENV=local                # local | staging | production  (gates email sending + test-data guards)

# ── CMS service (apps/cms/.env) ─────────────────────────────
DATABASE_URI=postgresql://cms_user:CHANGE_ME@postgres:5432/protocol_soft
PAYLOAD_SECRET=CHANGE_ME_long_random          # Payload auth/encryption secret
CMS_PORT=3001
CMS_EXTERNAL_URL=https://admin.protosoftdev.com
WEB_INTERNAL_URL=http://web:3000              # private network target for revalidation

# Internal API keys (high entropy; rotation via *_PREVIOUS overlap)
WEB_TO_CMS_CONTENT_READ_KEY=CHANGE_ME         # published public-content reads ONLY
WEB_TO_CMS_LEAD_SUBMIT_KEY=CHANGE_ME          # POST /api/internal/leads ONLY
CMS_TO_WEB_REVALIDATE_KEY=CHANGE_ME           # cms -> web revalidate ONLY
BACKUP_REPORT_KEY=CHANGE_ME                   # backup job -> cms record reporting ONLY

# Preview signing (asymmetric; PEM material, server-side only)
PREVIEW_SIGNING_PRIVATE_KEY=CHANGE_ME         # Ed25519 private key — cms ONLY, never leaves cms
# (the public half PREVIEW_VERIFY_PUBLIC_KEY is provisioned on the web service)

# Lead hashing (web + cms must match)
LEAD_IP_HASH_SECRET=CHANGE_ME

# Transactional email — env-gated (disabled unless DEPLOYMENT_ENV=production)
RESEND_API_KEY=                               # empty in dev/staging => notifications captured/dropped
EMAIL_SINK_ADDRESS=notifications-sink@example.invalid

# Backup control plane (control ONLY — never exposes keys/credentials/buckets/paths)
BACKUP_ENCRYPTION_PUBLIC_KEY=                 # age recipient public key; PRIVATE half stays off-dashboard
BACKUP_SPOOL_DIR=/backups/spool               # local encrypted spool until an off-server destination is approved

# ── Web service (apps/web/.env) ─────────────────────────────
# NO PostgreSQL credentials here — enforced by review + CI check (npm run verify:web)
CMS_INTERNAL_URL=http://cms:3001
WEB_PORT=3000
NEXT_PUBLIC_SITE_URL=https://protosoftdev.com
PREVIEW_VERIFY_PUBLIC_KEY=CHANGE_ME           # verifies cms-signed preview codes; cannot mint them
# (same values as cms where shared)
WEB_TO_CMS_CONTENT_READ_KEY=
WEB_TO_CMS_LEAD_SUBMIT_KEY=
LEAD_IP_HASH_SECRET=
CMS_TO_WEB_REVALIDATE_KEY=

# ── Infrastructure (compose env / server only) ──────────────
POSTGRES_DB=protocol_soft
POSTGRES_CMS_USER=cms_user                    # read/write (cms only)
POSTGRES_CMS_PASSWORD=CHANGE_ME
POSTGRES_MIGRATE_USER=migrate_user            # DDL-only, controlled deploys
POSTGRES_MIGRATE_PASSWORD=CHANGE_ME
POSTGRES_BACKUP_USER=backup_user              # read-only dumps
POSTGRES_BACKUP_PASSWORD=CHANGE_ME
CLOUDFLARE_TUNNEL_TOKEN=                      # server-side secret; cloudflared only, never in Git
ACME_EMAIL=hosting@protosoftdev.com           # Caddy TLS
