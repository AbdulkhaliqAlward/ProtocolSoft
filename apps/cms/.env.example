# CMS service environment — TEMPLATE ONLY (no real values). Real secrets live on the server only.
# The CMS is the ONLY application runtime service with PostgreSQL credentials.

NODE_ENV=development
DEPLOYMENT_ENV=local              # local | staging | production (gates email delivery)
CMS_PORT=3001
CMS_EXTERNAL_URL=https://admin.protosoftdev.com

# Database — least-privilege: cms_readwrite is the only app-runtime writer
DATABASE_URI=postgresql://cms_user:CHANGE_ME@postgres:5432/protocol_soft
PAYLOAD_SECRET=CHANGE_ME_long_random_string

# Internal API keys (one purpose each — see packages/shared/src/contracts.ts)
WEB_TO_CMS_CONTENT_READ_KEY=
WEB_TO_CMS_LEAD_SUBMIT_KEY=
BACKUP_REPORT_KEY=

# Revalidation push (cms -> web, private network)
WEB_INTERNAL_URL=http://web:3000
CMS_TO_WEB_REVALIDATE_KEY=

# Preview signing — private key NEVER leaves this service
PREVIEW_SIGNING_PRIVATE_KEY=

# Lead IP hashing (must match the web service value)
LEAD_IP_HASH_SECRET=

# Transactional email — sending enabled ONLY when DEPLOYMENT_ENV=production AND key present
RESEND_API_KEY=
EMAIL_SINK_ADDRESS=notifications-sink@example.invalid

# Backup control plane (control only; runner dormant until destination + restore test)
BACKUP_REPORT_KEY=
BACKUP_ENCRYPTION_PUBLIC_KEY=
BACKUP_SPOOL_DIR=./backups/spool

# First Super Admin bootstrap (used once by npm run bootstrap:superadmin; then remove from env)
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=
BOOTSTRAP_SUPERADMIN_NAME=
