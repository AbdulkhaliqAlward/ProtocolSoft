# Web service environment — TEMPLATE ONLY (no real values).
# HARD RULE: NO PostgreSQL credentials in this service — verified by `npm run verify:no-db -w @protocol-soft/web`.

NODE_ENV=development
DEPLOYMENT_ENV=local             # local | staging | production (gates test-data guards)
WEB_PORT=3000
NEXT_PUBLIC_SITE_URL=https://protosoftdev.com

# Private-network target of the CMS internal API
CMS_INTERNAL_URL=http://cms:3001

# Purpose-specific keys (same values as the cms server env; never in Git, never to the browser)
WEB_TO_CMS_CONTENT_READ_KEY=
WEB_TO_CMS_LEAD_SUBMIT_KEY=
LEAD_IP_HASH_SECRET=
CMS_TO_WEB_REVALIDATE_KEY=

# Preview: verify-only public key (cms holds the signing private key)
PREVIEW_VERIFY_PUBLIC_KEY=
