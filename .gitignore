# Dependencies
node_modules/
.pnp/

# Builds
dist/
build/
.next/
out/
*.tsbuildinfo

# NEVER commit secrets, keys, credentials, tokens, or storage configs.
# Only *.example env files are tracked (names only, no real values).
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Secrets / keys material (defense in depth — real secrets live only on the server)
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/
certs/

# Payload media. apps/cms/src/payload-types.ts is generated from the schema but
# TRACKED: the CMS build type-checks against it, so a clean clone needs it.
# Regenerate with `npx payload generate:types` (in apps/cms) after schema changes.
apps/cms/media/
apps/cms/media-staging/
apps/cms/backups/

# Logs / OS
logs/
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Test artifacts & scratch
coverage/
verification-output/*.json
*.ps1
cms-log.txt
cms-err.txt
verify-output.txt

# Local databases (dev uses Postgres in Docker; never commit DB files)
*.db
*.sqlite
*.sqlite3

# Generated by `next dev` (Next 16 agent rules); re-created on every dev run
**/AGENTS.md
# Regenerated by Next 16 on every dev/build (paths differ between the two)
next-env.d.ts
