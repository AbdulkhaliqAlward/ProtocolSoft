{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cms",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:cms"],
      "port": 3001
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:web"],
      "port": 3000
    },
    {
      "name": "cms-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "-w", "@protocol-soft/cms"],
      "port": 3001
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "-w", "@protocol-soft/web"],
      "port": 3000
    }
  ]
}
